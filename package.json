{
	"name": "pi-extensions",
	"version": "0.1.0",
	"private": true,
	"description": "Optional extensions for the Pi coding agent",
	"license": "MIT",
	"type": "module",
	"keywords": ["pi-package"],
	"workspaces": ["extensions/*"],
	"pi": {
		"extensions": ["./extensions/*/src/index.ts"]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test",
		"check": "bun run typecheck && bun run lint && bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"bun-types": "^1.3.0",
		"typescript": "^7.0.2"
	}
}
